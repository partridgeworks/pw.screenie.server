# Environment Variables for Screenie Web
# Copy this file to .env.development or .env.production and fill in your values

# Application URL
NEXT_PUBLIC_APP_URL=https://localhost:3000

# MongoDB Connection
# For local development:
DATABASE_URI=mongodb://localhost:27017/pw-screeny?directConnection=true
# For production (example with authentication):
# DATABASE_URI=mongodb://username:password@localhost:27017/pw-screeny?authSource=admin

# Clerk Authentication (https://clerk.com)
# Create an account at Clerk and get your keys from the dashboard
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
CLERK_SECRET_KEY=sk_test_your_secret_key_here

# Logging Configuration
LOG_LEVEL=info
DEBUG_FILE_ENABLED=false
DEBUG_FILE_PATH=logs/{variant}-screeny-debug.log
DEBUG_FILE_MAX_SIZE=10485760

# Push Notifications (VAPID keys)
# Generate your own keys with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_SUBJECT=mailto:your-email@example.com
