import { createHash, randomBytes } from "crypto";
import { NextRequest } from "next/server";
import APIKeyModel, { apiKey } from "@/lib/models/APIKey";
import UserModel, { user } from "@/lib/models/User";
import { getMongoose } from "@/lib/utils/mongo";
import logger from "@/lib/utils/serverLogger";

const API_KEY_PREFIX = "thk_";
const API_KEY_HEADER = "X-API-Key";

/**
 * Generates a new API key with format: thk_<32 hex chars>
 * Returns the raw key (only shown once) and its hash for storage
 */
export function generateAPIKey(): { rawKey: string; keyHash: string; keyPrefix: string } {
  const randomPart = randomBytes(16).toString("hex"); // 32 hex chars
  const rawKey = `${API_KEY_PREFIX}${randomPart}`;
  const keyHash = hashAPIKey(rawKey);
  const keyPrefix = rawKey.substring(0, 8); // e.g., "thk_a1b2"

  return { rawKey, keyHash, keyPrefix };
}

/**
 * Creates a SHA-256 hash of an API key for secure storage
 */
export function hashAPIKey(key: string): string {
  return createHash("sha256").update(key).digest("hex");
}

/**
 * Validates the format of an API key
 */
export function isValidAPIKeyFormat(key: string): boolean {
  // Should be thk_ followed by exactly 32 hex characters
  const regex = new RegExp(`^${API_KEY_PREFIX}[a-f0-9]{32}$`);
  return regex.test(key);
}

/**
 * Extracts the API key from the request header
 */
export function getAPIKeyFromRequest(req: NextRequest): string | null {
  return req.headers.get(API_KEY_HEADER);
}

/**
 * Validates an API key and returns the associated API key document if valid
 * Returns null if the key is invalid, expired, inactive, or deleted
 */
export async function validateAPIKey(key: string): Promise<apiKey | null> {
  if (!isValidAPIKeyFormat(key)) {
    return null;
  }

  const keyHash = hashAPIKey(key);

  const apiKeyDoc = await APIKeyModel.findOne({
    keyHash,
    isActive: true,
    IsDeleted: false
  }).lean<apiKey>();

  if (!apiKeyDoc) {
    return null;
  }

  // Check expiration
  if (apiKeyDoc.expiresAt && new Date(apiKeyDoc.expiresAt) < new Date()) {
    return null;
  }

  // Update lastUsedAt asynchronously (fire and forget)
  APIKeyModel.updateOne(
    { _id: apiKeyDoc._id },
    { $set: { lastUsedAt: new Date() } }
  ).exec().catch((err) => {
    logger.warn("Failed to update API key lastUsedAt", { error: err });
  });

  return apiKeyDoc;
}

/**
 * Attempts to authenticate a request using an API key.
 * Returns a user object with the API key's role patched in, or null if no valid API key.
 */
export async function getUserFromAPIKey(req: NextRequest): Promise<user | null> {
  const apiKey = getAPIKeyFromRequest(req);

  if (!apiKey) {
    return null;
  }

  await getMongoose();

  const apiKeyDoc = await validateAPIKey(apiKey);

  if (!apiKeyDoc) {
    logger.warn("Invalid or expired API key used", { keyPrefix: apiKey.substring(0, 8) });
    return null;
  }

  // Look up the associated user
  const linkedUser = await UserModel.findById(apiKeyDoc.userId).lean<user>();

  if (!linkedUser) {
    logger.error("API key references non-existent user", { 
      apiKeyId: apiKeyDoc._id, 
      userId: apiKeyDoc.userId 
    });
    return null;
  }

  // Return user with applicationRole patched from the API key
  return {
    ...linkedUser,
    applicationRole: apiKeyDoc.applicationRole
  };
}

export { API_KEY_HEADER };
